# =============================================================================
# Nimbus FinServe I-ITSM Environment Variables Template
# Copy this file to .env and configure strong production credentials.
# =============================================================================

# Mandatory 256-bit (>= 32 bytes) cryptographically secure secret
JWT_SECRET=super-secure-production-grade-secret-key-change-me-at-least-32-bytes

# Server HTTP Port
PORT=8085

# Production Database Credentials
DB_HOST=postgres
DB_PORT=5432
DB_NAME=iitsm_prod
DB_USER=postgres
DB_PASSWORD=postgres

# Outbound SMTP Mail Configuration (Default: Mailpit mock on port 1025)
MAIL_HOST=mailpit
MAIL_PORT=1025

